{"Version":"2012-10-17","Statement":[
 {"Sid":"IAMReadAndAudit","Effect":"Allow","Action":
["iam:Get*","iam:List*","iam:GenerateCredentialReport","iam:GenerateServiceLastAccessedDetails","iam:SimulatePrincipalPolicy","iam:SimulateCustomPolicy","cloudtrail:LookupEvents","access-analyzer:List*","access-analyzer:Get*"],"Resource":"*"},
 {"Sid":"AuthorOnlyNimbusPolicies","Effect":"Allow","Action":["iam:CreatePolicy","iam:CreatePolicyVersion","iam:DeletePolicyVersion"],"Resource":"arn:aws:iam::__ACCOUNT_ID__:policy/nimbus/*"},
 {"Sid":"NoApplicationDataOrSecrets","Effect":"Deny","Action":["s3:GetObject","secretsmanager:GetSecretValue","dynamodb:GetItem","dynamodb:Query"],"Resource":"*"}]}
