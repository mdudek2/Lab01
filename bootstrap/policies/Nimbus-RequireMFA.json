{"Version":"2012-10-17","Statement":[
 {"Sid":"AllowSelfServiceCredentialSetup","Effect":"Allow",
  "Action":
["iam:ChangePassword","iam:GetUser","iam:CreateVirtualMFADevice","iam:DeleteVirtualMFADevice","iam:EnableMFADevice","iam:ListMFADevices","iam:ResyncMFADevice"],
  "Resource":["arn:aws:iam::__ACCOUNT_ID__:user/nimbus/${aws:username}","arn:aws:iam::__ACCOUNT_ID__:mfa/${aws:username}"]},
 {"Sid":"AllowMFAHelperCallsOnStar","Effect":"Allow",
  "Action":["iam:ListVirtualMFADevices","iam:GetAccountPasswordPolicy"],"Resource":"*"},
 {"Sid":"DenyEverythingExceptMFASetupWhenNoMFA","Effect":"Deny",
  "NotAction":
["iam:ChangePassword","iam:GetUser","iam:CreateVirtualMFADevice","iam:DeleteVirtualMFADevice","iam:EnableMFADevice","iam:ListMFADevices","iam:ListVirtualMFADevices","iam:ResyncMFADevice","iam:GetAccountPasswordPolicy","sts:GetSessionToken"],
  "Resource":"*","Condition":{"BoolIfExists":{"aws:MultiFactorAuthPresent":"false"}}}]}
