{"Version":"2012-10-17","Statement":[
 {"Sid":"DevS3ReadWriteDevPrefixOnly","Effect":"Allow","Action":["s3:GetObject","s3:PutObject"],"Resource":"arn:aws:s3:::*/dev/*"},
 {"Sid":"DevDynamoDBTaggedDevTables","Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem","dynamodb:Query"],
  "Resource":"arn:aws:dynamodb:*:*:table/*-dev","Condition":{"StringEquals":{"aws:ResourceTag/env":"dev"}}},

{"Sid":"DevLambdaInvokeDevOnly","Effect":"Allow","Action":"lambda:InvokeFunction","Resource":"arn:aws:lambda:*:*:function:*-dev-*"},
 {"Sid":"DenyPrivilegeEscalationAndBilling","Effect":"Deny",
  "Action":["aws-portal:*","billing:*","iam:CreateUser","iam:CreateRole","iam:CreatePolicy","iam:CreatePolicyVersion","iam:AttachUserPolicy","iam:AttachGroupPolicy","iam:AttachRolePolicy","iam:PutUserPolicy","iam:PutGroupPolicy","iam:PutRolePolicy","iam:AddUserToGroup","iam:UpdateAssumeRolePolicy","iam:PassRole"],
  "Resource":"*"}]}
