{"Version":"2012-10-17","Statement":[
 {"Sid":"DenyInsecureTransport","Effect":"Deny","Principal":{"AWS":"*"},"Action":"s3:*",
  "Resource":["arn:aws:s3:::__BUCKET__","arn:aws:s3:::__BUCKET__/*"],"Condition":{"Bool":{"aws:SecureTransport":"false"}}},
 {"Sid":"DenyOldTLS","Effect":"Deny","Principal":{"AWS":"*"},"Action":"s3:*",
  "Resource":["arn:aws:s3:::__BUCKET__","arn:aws:s3:::__BUCKET__/*"],"Condition":{"NumericLessThan":{"s3:TlsVersion":"1.2"}}}]}
