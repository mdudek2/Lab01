{"Version":"2012-10-17","Statement":[
 {"Sid":"ListNimbusUsers","Effect":"Allow","Action":"iam:ListUsers","Resource":"*"},
 {"Sid":"ReadNimbusUserState","Effect":"Allow","Action":["iam:GetUser","iam:GetLoginProfile","iam:ListAccessKeys","iam:ListGroupsForUser","iam:ListMFADevices","iam:ListAttachedUserPolicies","iam:ListUserTags"],"Resource":"arn:aws:iam::__ACCOUNT_ID__:user/nimbus/*"},
 {"Sid":"ReadRegistry","Effect":"Allow","Action":"s3:GetObject","Resource":["arn:aws:s3:::__BUCKET__/registry/*","arn:aws:s3:::__BUCKET__/audit/*"]},

{"Sid":"ListRegistry","Effect":"Allow","Action":"s3:ListBucket","Resource":"arn:aws:s3:::__BUCKET__","Condition":{"StringLike":{"s3:prefix":["registry/*","audit/*"]}}},

{"Sid":"ReadInternalToken","Effect":"Allow","Action":"secretsmanager:GetSecretValue","Resource":"arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:nimbus/internal-token-*"}]}
